# TripWeave 生产机密（复制为 .env.prod 后填入真实值，.env.prod 不进 git）
# compose: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- 数据库/缓存（生产必须改） ---
DB_PASSWORD=change-me-strong-db-password
REDIS_PASSWORD=change-me-strong-redis-password

# --- JWT ---
JWT_SECRET=change-me-long-random-jwt-secret
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=720h

# --- AI（DeepSeek） ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_MAX_TOOL_ROUNDS=5

# --- 高德 ---
AMAP_SERVICE_KEY=
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# --- SMTP（QQ 邮箱授权码） ---
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TripWeave <noreply@example.com>

# --- 站点 ---
# 拿到域名后改成 https://your-domain；暂时用 http://<公网IP>
APP_BASE_URL=http://your-public-ip
# CORS：与 APP_BASE_URL 一致（同源部署时其实用不到，保留保险）
CORS_ORIGINS=http://your-public-ip
